# Credenciais do "Cadastro de sistema externo" (API SIEG para Clientes SIEG
# → Cadastro → Formulário). Chegam por e-mail após aprovação, num link
# "External-system-token" que só mostra os valores uma vez.
SIEG_CLIENT_ID=
SIEG_SECRET_KEY=

# Chave gerada em: Minha Conta >> Integrações API SIEG (usuário administrador).
# Usada em conjunto com o JWT (gerado a partir de CLIENT_ID/SECRET_KEY acima)
# em toda chamada — não substitui as credenciais de cima, complementa.
SIEG_API_KEY=

# URL base da API SIEG (normalmente não precisa mudar)
SIEG_API_BASE_URL=https://api.sieg.com

# Porta em que o backend/proxy vai escutar
PORT=3001

# Quando true, nenhuma chamada real é feita à SIEG: os endpoints usam os
# XMLs de exemplo em src/data/fixtures/*.xml. Útil para desenvolver o
# front-end e validar a lógica de quebra de sequência/tributos sem
# consumir a cota da API ou precisar de credenciais reais.
MOCK_MODE=true

# Login do painel (HTTP Basic Auth). Se deixar em branco, o painel fica
# aberto sem senha — ok para dev local, NUNCA deixe em branco em produção
# (Vercel). Escolha um usuário/senha só seus, não use os de exemplo abaixo.
ADMIN_USER=
ADMIN_PASSWORD=

# Token gerado automaticamente pela Vercel quando você conecta uma store do
# Vercel Blob ao projeto (Storage → Create Database → Blob). Só precisa
# disso em produção; em dev local sem essa variável, a lista de clientes
# continua sendo salva em src/data/clients.json normalmente.
BLOB_READ_WRITE_TOKEN=

