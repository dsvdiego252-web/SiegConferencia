    "estrategia_busca_por_segmento": [
      "consultar o segmento/anexo da CAT 68",
      "buscar atos CAT/SRE que mencionem o Anexo correspondente da Portaria CAT 68/2019",
      "buscar atos com termos 'base de cálculo', 'IVA-ST', 'Índice de Valor Adicionado Setorial', 'PMPF', 'preço final', 'preço a consumidor', 'substituição tributária'",
      "identificar norma vigente para a data de emissão",
      "seguir atos alteradores, revogadores e normas anteriores quando necessário",
      "montar cadeia normativa completa"
    ],
    "termos_busca_modelo": [
      "\"Anexo {ANEXO}\" \"Portaria CAT 68/19\" \"IVA-ST\"",
      "\"Anexo {ANEXO}\" \"Portaria CAT 68/19\" \"base de cálculo\"",
      "\"{SEGMENTO}\" \"IVA-ST\" \"Portaria SRE\"",
      "\"{SEGMENTO}\" \"PMPF\" \"Portaria SRE\"",
      "\"{ARTIGO_RICMS}\" \"base de cálculo\" \"Portaria SRE\""
    ]
  },
  "pipeline": [
    {
      "passo": 1,
      "acao": "receber_data_emissao_e_produto",
      "entrada": [
        "data_emissao",
        "ncm",
        "descricao",
        "cest",
        "uf_origem",
        "uf_destino"
      ]
    },
    {
      "passo": 2,
      "acao": "consultar_cat68",
      "resultado": [
        "sujeito_st",
        "anexo",
        "segmento",
        "item_cat68",
        "vigencia_item"
      ]
    },
    {
      "passo": 3,
      "acao": "se_nao_st_encerrar",
      "status": "NAO_SUJEITO_ST_NA_DATA"
    },
    {
      "passo": 4,
      "acao": "descobrir_norma_base_calculo_do_segmento",
      "usar_portal_oficial": true
    },
    {
      "passo": 5,
      "acao": "baixar_e_salvar_fonte_original",
      "salvar_html": true,
      "salvar_texto_extraido": true,
      "salvar_hash_sha256": true
    },
    {
      "passo": 6,
      "acao": "resolver_cadeia_normativa",
      "itens": [
        "ato_principal",
        "ato_alterador",
        "ato_revogador",
        "vigencia_inicio",
        "vigencia_fim",
        "norma_anterior",
        "norma_posterior"
      ]
    },
    {
      "passo": 7,
      "acao": "identificar_metodo_base_calculo",
      "metodos_possiveis": [
        "IVA_ST",
        "IVA_ST_AJUSTADO",
        "PMPF",
        "PRECO_FIXADO",
        "PAUTA",
        "PRECO_SUGERIDO",
        "PERCENTUAL_MARGEM",
        "OUTRO_METODO_OFICIAL"
      ]
    },
    {
      "passo": 8,
      "acao": "extrair_tabelas_e_regras"
    },
    {
      "passo": 9,
      "acao": "versionar_por_vigencia"
    },
    {
      "passo": 10,
      "acao": "validar_contra_cat68"
    },
    {
      "passo": 11,
      "acao": "publicar_base_local",
      "arquivo": "mva_iva_sp_por_segmento.json"
    }
  ],
