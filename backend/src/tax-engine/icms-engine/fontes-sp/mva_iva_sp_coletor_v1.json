      "condicoes_especificas_da_norma",
      "metodo_base_calculo"
    ],
    "regras": [
      "Nunca escolher MVA/IVA apenas por NCM.",
      "Quando a norma contiver CEST + NCM + descrição, validar os três.",
      "Quando houver marca, embalagem, volume, peso, tipo de remetente/destinatário ou finalidade, essas condições são obrigatórias.",
      "Se o mesmo item tiver mais de uma redação, escolher a versão cuja vigência contenha a data de emissão.",
      "Se houver conflito entre norma atual e histórica, a data de emissão decide.",
      "Se não for possível comprovar a regra aplicável, retornar REVISAO_MANUAL."
    ]
  },
  "iva_ajustado": {
    "usar_somente_quando_a_norma_previr": true,
    "formula_padrao_identificada_em_normas_sp": "[(1 + IVA_ST_ORIGINAL) * (1 - ALQ_INTER) / (1 - ALQ_INTRA)] - 1",
    "variaveis": {
      "IVA_ST_ORIGINAL": "IVA-ST aplicável na operação interna",
      "ALQ_INTER": "alíquota interestadual efetivamente aplicada pelo remetente",
      "ALQ_INTRA": "alíquota interna aplicável à mercadoria em São Paulo"
    },
    "regra": "Não aplicar automaticamente a fórmula a todos os segmentos. Confirmar no texto da norma do segmento/data que o IVA-ST ajustado é exigido."
  },
  "pmpf_e_precos": {
    "suportar": true,
    "regra": "Quando a norma trouxer PMPF/preço fixado por marca, descrição, embalagem ou volume, armazenar esses valores como regras específicas. Não substituir automaticamente por IVA-ST.",
    "precedencia": "A precedência entre PMPF/preço fixado e IVA-ST deve ser extraída do próprio ato. Não assumir uma precedência universal.",
    "fallback": "Quando o próprio ato determinar que, em certas hipóteses, o PMPF não se aplica e deve ser usado IVA-ST, modelar essa condição explicitamente."
  },
