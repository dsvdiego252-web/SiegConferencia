    "quantidade_segmentos_anexos": 22,
    "finalidade": "Identificar o segmento/anexo e determinar se a mercadoria pode estar sujeita ao regime de substituição tributária em São Paulo, respeitando item, CEST, NCM/SH, descrição e vigência."
  },
  "observacao_motor": {
    "texto": "UTILIZAR A PORTARIA CAT 68/2019 COMO MAPA MESTRE DA ST DE SÃO PAULO POR SEGMENTO. O MOTOR DEVE PRIMEIRO IDENTIFICAR O SEGMENTO/ANEXO E, DEPOIS, VALIDAR O ITEM ESPECÍFICO PELA COMBINAÇÃO CEST + NCM/SH + DESCRIÇÃO + DATA DA OPERAÇÃO. NCM OU SEGMENTO ISOLADAMENTE NÃO CONFIRMAM ST. REVOGAÇÕES E REDAÇÕES POR ITEM PREVALECEM SOBRE O STATUS GERAL DO ANEXO.",
    "mva": "A PORTARIA CAT 68/2019 NÃO DEVE SER USADA COMO FONTE DE MVA/IVA. APÓS CONFIRMAR QUE O ITEM ESTÁ SUJEITO À ST, O MOTOR DEVE CONSULTAR A BASE DE MVA/IVA DO RESPECTIVO SEGMENTO, VIGENTE NA DATA DA OPERAÇÃO.",
    "sem_base_mva": "SE O ITEM ESTIVER EM ST MAS A BASE DE MVA/IVA DO SEGMENTO AINDA NÃO ESTIVER CADASTRADA, RETORNAR BASE_MVA_NAO_CADASTRADA / REVISAO_MANUAL. NUNCA INVENTAR MVA.",
    "precedencia": [
      "VIGENCIA_ESPECIFICA_DO_ITEM",
